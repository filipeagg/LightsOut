# LightsOut environment. Copy to .env and adjust. Never commit .env (NF-02).

# --- Host side (required) ---
# Host path bind-mounted at /workspace. Use a WSL2 ext4 path, not /mnt/c (RT-02).
LIGHTSOUT_WORKSPACE=/home/CHANGEME/lightsout-data

# Host port for panel + JSON API + /mcp. Bound to 127.0.0.1 only (WP-09).
LO_PORT=8484

# --- Runtime limits ---
LO_MAX_PARALLEL=3
LO_TIMEOUT_QUICK_MIN=30
LO_TIMEOUT_FULL_MIN=90
LO_INACTIVITY_MIN=8
LO_PERMISSION_WAIT_HOURS=24
LO_ADVISOR_CONFIDENCE=0.7
LO_EVENT_RETENTION_DAYS=90

# --- ACP adapters (commands on PATH inside the container) ---
LO_ADAPTER_CLAUDE=claude-agent-acp
LO_ADAPTER_CODEX=codex-acp

# --- Egress allowlist (used by the tinyproxy sidecar, RT-05) ---
# Extra hosts to allow beyond the engine/auth defaults, comma-separated.
# Add your git remote hosts here, e.g. github.com,gitlab.com
LO_ALLOWED_HOSTS=

# --- Git push credentials (optional, PM-05) ---
# Either a token consumed by the git credential helper, or mount ~/.ssh read-only
# by uncommenting the ssh volume in docker-compose.yml.
GIT_TOKEN=
SSH_DIR=~/.ssh
