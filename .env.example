# LightsOut environment. Copy to .env and adjust. Never commit .env (NF-02).

# --- Host side (all optional: defaults work as-is) ---
# Projects, agent profiles, templates and knowledge live in a folder on this machine
# (RT-02), bind-mounted at /workspace, so they open in your own editor. Default:
# %USERPROFILE%\Documents\LightsOut on Windows, ~/LightsOut elsewhere.
#LIGHTSOUT_WORKSPACE=/home/CHANGEME/LightsOut

# `host` (bind mount, default) or `volume` (managed volume, headless installs). For
# `volume`, start with: docker compose -f docker-compose.yml -f docker-compose.volume.yml up -d
#LO_WORKSPACE_MODE=host

# Poll interval of the agent, template and knowledge loaders. Bind mounts do not
# deliver reliable filesystem events, so the loaders poll instead (AP-03).
#LO_WATCH_POLL_MS=2000

# Host folder used as the target when exporting a project from the panel (SU-06).
#LO_EXPORT_DIR=/home/CHANGEME/lightsout-export

# Host port for panel + JSON API + /mcp. Bound to 127.0.0.1 only (WP-09).
LO_PORT=8484

# --- Runtime limits ---
LO_MAX_PARALLEL=3
LO_TIMEOUT_QUICK_MIN=30
LO_TIMEOUT_FULL_MIN=90
LO_INACTIVITY_MIN=8
LO_PERMISSION_WAIT_HOURS=24
LO_ADVISOR_CONFIDENCE=0.7
LO_EVENT_RETENTION_DAYS=90
# How much curated knowledge one prompt may carry (KB-06). Manifests and index.md are
# always injected; documents fill what is left.
LO_KNOWLEDGE_BUDGET_CHARS=120000

# --- ACP adapters (commands on PATH inside the container) ---
LO_ADAPTER_CLAUDE=claude-agent-acp
LO_ADAPTER_CODEX=codex-acp

# --- Egress allowlist (used by the tinyproxy sidecar, RT-05) ---
# Extra hosts to allow beyond the engine/auth defaults, comma-separated.
# Add your git remote hosts here, e.g. github.com,gitlab.com
LO_ALLOWED_HOSTS=

# --- Git push credentials (optional, PM-05) ---
# Either a token consumed by the git credential helper, or mount ~/.ssh read-only
# by uncommenting the ssh volume in docker-compose.yml.
GIT_TOKEN=
SSH_DIR=~/.ssh
